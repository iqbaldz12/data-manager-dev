{
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0"
        }
    },
    "installCommand": "npm install && composer install --no-dev --optimize-autoloader",
    "buildCommand": "npm run build",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/index.php"
        }
    ]
}