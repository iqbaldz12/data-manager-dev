APP_NAME="Codexa Data Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-PROJECT.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=error

# ─── DATABASE ────────────────────────────────────────────────────────────────
# Gunakan Neon (neon.tech) - Free PostgreSQL serverless
# Format: postgresql://user:password@host/dbname?sslmode=require
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ─── SESSION ─────────────────────────────────────────────────────────────────
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.vercel.app

# ─── CACHE ───────────────────────────────────────────────────────────────────
CACHE_STORE=database

# ─── QUEUE ───────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database

# ─── FILESYSTEM ──────────────────────────────────────────────────────────────
FILESYSTEM_DISK=public

# ─── MAIL ────────────────────────────────────────────────────────────────────
MAIL_MAILER=log

# ─── VITE ────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
